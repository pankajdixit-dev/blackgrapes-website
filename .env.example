# ==============================================================================
# BLACK GRAPES SOFTECH - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port on which the backend server will run
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cluster Connection URL
# Replace with your actual MongoDB connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blackgrapes?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blackgrapes?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=blackgrapes_super_secure_jwt_secret_key_2026
JWT_EXPIRE=30d

# Initial Superadmin Credentials (Automatically seeded into MongoDB on first connection)
DEFAULT_ADMIN_NAME=Black Grapes Admin
DEFAULT_ADMIN_EMAIL=admin@blackgrapessoftech.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Frontend Client URLs (CORS permissions)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
