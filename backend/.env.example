# Black Grapes Softech - Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local fallback)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/blackgrapes?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/blackgrapes

# JWT Secret Key for Secure Admin Authentication
# Generate a strong 64-character secret
JWT_SECRET=blackgrapes_super_secure_jwt_secret_key_2026_xyz987654321
JWT_EXPIRE=7d

# Allowed Client Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (For image and document storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

