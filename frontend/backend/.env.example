# ==============================================================================
# BLACK GRAPES SOFTECH - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 🔴 MONGODB ATLAS CLUSTER CONNECTION URL:
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blackgrapes?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# ☁️ CLOUDINARY CLOUD STORAGE FOR IMAGES & VIDEOS:
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY:
# ------------------------------------------------------------------------------
JWT_SECRET=blackgrapes_super_secure_jwt_secret_key_2026
JWT_EXPIRE=30d

DEFAULT_ADMIN_NAME=Black Grapes Admin
DEFAULT_ADMIN_EMAIL=admin@blackgrapessoftech.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
